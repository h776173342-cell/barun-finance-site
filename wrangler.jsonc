{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barun-finance-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "APPLICATIONS",
      "database_name": "barun-finance-applications",
      "database_id": "eebc978e-bccf-4412-b8f3-7589605f37e8"
    }
  ]
}
